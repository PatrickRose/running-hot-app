<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Pinned so the suite does not need a .env. A clean checkout has
             none, so every feature test died on "No application encryption key
             has been specified" until someone ran composer setup - which reads
             as the change under test having broken the application rather than
             as a missing file. It encrypts nothing: the suite's sessions, cache
             and database are all thrown away with the process. -->
        <env name="APP_KEY" value="base64:hKWrwtdtL6pvT7X4+W3u35xxJFe4SNoZClTY3Pyo68k="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            Pinned rather than left to the environment. `composer setup` copies
            .env.example into place, and that turns this on so a fresh checkout
            can use the logins DemoGameSeeder prints - so without this line the
            suite runs on whichever posture the developer's .env happens to
            carry, and CI ran on the opposite one to a laptop with no .env at
            all. Off is the posture a deployment ships with, which is the one
            worth proving the application works in; the three test files whose
            subject is the password form turn it back on in their own setUp.

            "(false)" rather than "false": PHPUnit reads the second as a
            boolean and writes it into $_ENV as an empty string, which is falsy
            but is not `false`. Laravel's Env converts the parenthesised form
            to a real boolean.
        -->
        <env name="RUNNING_HOT_DIRECT_LOGIN" value="(false)"/>
        <env name="DISCORD_CLIENT_ID" value="testing"/>
        <env name="DISCORD_CLIENT_SECRET" value="testing"/>
        <!-- Blanked for the same reason as the webhook: the sync queue driver
             runs the role-sync job inline, so a real bot token in .env would
             have the suite editing a live Discord server. Tests that exercise
             the bot set this themselves alongside an Http::fake. -->
        <env name="DISCORD_BOT_TOKEN" value=""/>
    </php>
</phpunit>
